&"1_1": {
"audio_clip": null,
"dialogue": "The woman you see in front of you is familiar. 
You realize you know her, though you don’t remember how. ",
"offset": Vector2(229.51501, 168.66),
"options": {
0: {
"condition": {},
"link": &"1_2",
"text": ""
}
},
"size": Vector2(339.9997, 576),
"speaker": ""
},
&"1_10": {
"audio_clip": null,
"dialogue": "Once again, you gaze upon the mysteriously familiar figure whom  you know as Kouya.",
"offset": Vector2(160, 1840),
"options": {
0: {
"condition": {},
"link": &"1_11",
"text": ""
}
},
"size": Vector2(340, 399.99988),
"speaker": ""
},
&"1_11": {
"audio_clip": null,
"dialogue": "Kouya has, of course, assisted many of the famous and wealthy in their courting rituals. All the while, he dreamt of someone one day preparing these rituals for him.",
"offset": Vector2(560, 1840),
"options": {
0: {
"condition": {},
"link": &"1_12",
"text": ""
}
},
"size": Vector2(360.00012, 399.99988),
"speaker": ""
},
&"1_12": {
"audio_clip": null,
"dialogue": "These dreams in mind, he performed his ceremonial duties with gusto. And if any mistakes were made in the process, [color=red] his temper could be a sight to behold.[/color]",
"offset": Vector2(980, 1840),
"options": {
0: {
"condition": {},
"link": "END",
"text": ""
}
},
"size": Vector2(360, 380),
"speaker": ""
},
&"1_2": {
"audio_clip": null,
"dialogue": "She is Yono, the daughter of a wealthy family. 
It is well known that Yono is very modest, and is uncomfortable being looked at. ",
"offset": Vector2(600, 180),
"options": {
0: {
"condition": {},
"link": &"1_3",
"text": ""
}
},
"size": Vector2(300, 575.9999),
"speaker": ""
},
&"1_3": {
"audio_clip": null,
"dialogue": "Sometimes, [color=red]it can make her very upset…[/color]",
"offset": Vector2(940, 180),
"options": {
0: {
"condition": {},
"link": "END",
"text": ""
}
},
"size": Vector2(360.00037, 575.9999),
"speaker": ""
},
&"1_4": {
"audio_clip": null,
"dialogue": "The man you see in front of you is someone you know you’ve seen before and know, though you can’t recall how. 
He is Kouya, a servant of Yono’s family.",
"offset": Vector2(180, 660),
"options": {
0: {
"condition": {},
"link": &"1_5",
"text": ""
}
},
"size": Vector2(380.00024, 576.0005),
"speaker": ""
},
&"1_5": {
"audio_clip": null,
"dialogue": "Kouya wants to make sure all is right with the house, and wants you to make sure you see that he is there to look after things.",
"offset": Vector2(600, 660),
"options": {
0: {
"condition": {},
"link": &"1_6",
"text": ""
}
},
"size": Vector2(300, 576.0005),
"speaker": ""
},
&"1_6": {
"audio_clip": null,
"dialogue": "In fact, if you look away for too long, [color=red]he can become extremely frustrated…[/color]
",
"offset": Vector2(940, 660),
"options": {
0: {
"condition": {},
"link": "END",
"text": ""
}
},
"size": Vector2(340.00012, 576.0005),
"speaker": ""
},
&"1_7": {
"audio_clip": null,
"dialogue": "Once again, you gaze upon the mysteriously familiar figure whom  you know as Yono.",
"offset": Vector2(160, 1360),
"options": {
0: {
"condition": {},
"link": &"1_8",
"text": ""
}
},
"size": Vector2(340, 420.00037),
"speaker": ""
},
&"1_8": {
"audio_clip": null,
"dialogue": "Notoriously shy, she would often find herself lost for words before others... her beloved, especially.",
"offset": Vector2(560, 1360),
"options": {
0: {
"condition": {},
"link": &"1_9",
"text": ""
}
},
"size": Vector2(360.00037, 420.00037),
"speaker": ""
},
&"1_9": {
"audio_clip": null,
"dialogue": "With an [color=yellow] inkwell in hand[/color], however, she privately renders her rich internal world onto pages upon pages of letters.",
"offset": Vector2(980, 1380),
"options": {
0: {
"condition": {},
"link": "END",
"text": ""
}
},
"size": Vector2(340, 420.00037),
"speaker": ""
}
